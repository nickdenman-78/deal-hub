<?xml version="1.0" encoding="utf-8"?>
<Project>
    <!-- Test projects do not inherit the root Directory.Build.props automatically once this file exists;
         import it so analyzers, annotations and coverage still apply. -->
    <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

    <PropertyGroup>
        <!-- xUnit v3 test projects are executables. -->
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
        <!-- CA1707: test names use underscores (Confirm_Fails_WhenDealIsCancelled). -->
        <NoWarn>$(NoWarn);CA1707</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk"/>
        <PackageReference Include="xunit.v3"/>
        <PackageReference Include="Shouldly"/>
        <PackageReference Include="xunit.runner.visualstudio">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>
</Project>
