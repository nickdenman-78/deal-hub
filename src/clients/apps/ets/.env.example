# Copy to .env.local to override. Defaults match the Aspire AppHost
# (Keycloak on :8080, realm "ets", public PKCE client "ets-web").
VITE_OIDC_AUTHORITY=http://localhost:8080/realms/ets
VITE_OIDC_CLIENT_ID=ets-web
VITE_OIDC_SCOPE=openid profile email

# Dev server only: where /api is proxied. Ets.Servers.Api's "http" launch profile.
ETS_API=http://localhost:5201
