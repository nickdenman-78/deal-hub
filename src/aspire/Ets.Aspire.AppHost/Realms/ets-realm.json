{
  "realm": "ets",
  "displayName": "Energy Trading System (local development)",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "accessTokenLifespan": 900,
  "clients": [
    {
      "clientId": "ets-api",
      "name": "ETS API",
      "description": "The resource server. Bearer-only: it validates tokens and never signs anyone in. Its client id is the audience the API requires.",
      "enabled": true,
      "bearerOnly": true,
      "publicClient": false,
      "protocol": "openid-connect"
    },
    {
      "clientId": "ets-scalar",
      "name": "ETS API reference (local)",
      "description": "Public PKCE client used by the Scalar reference UI in Development. Local only: wildcard redirects.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "redirectUris": [
        "*"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "ets-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "ets-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "ets-web",
      "name": "ETS web (local)",
      "description": "Public PKCE client for the ETS Vue SPA (src/clients/apps/ets). Local dev server on :5300.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "redirectUris": [
        "http://localhost:5300/auth/callback"
      ],
      "webOrigins": [
        "http://localhost:5300"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5300/*"
      },
      "protocolMappers": [
        {
          "name": "ets-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "ets-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ],
      "rootUrl": "http://localhost:5300"
    }
  ],
  "users": [
    {
      "id": "0b2f6c1e-7d4a-4c9b-8e35-5a1d2f3c4b6e",
      "username": "trader",
      "email": "trader@ets.local",
      "firstName": "Local",
      "lastName": "Trader",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "trader",
          "temporary": false
        }
      ]
    }
  ]
}
